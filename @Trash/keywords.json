{
    "name": "Keywords Blocklist",
    "sources": [
        {
            "source": "Sources/blocklist.txt",
            "transformations": [
                "ConvertToAscii",
                "TrimLines",
                "RemoveComments",
                "RemoveEmptyLines",
                "Compress",
                "Validate"
            ],
            "exclusions": [
                "*@@*"
            ]
        }
    ],
    "transformations": [
        "Deduplicate",
        "InsertFinalNewLine"
    ]
}