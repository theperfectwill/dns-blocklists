{
    "name": "Primary domains only",
    "sources": [
        {
            "source": "Regex/Sorted/keywords.txt",
            "transformations": [],
            "inclusions": [
                "/^\\b([a-zA-Z0-9-]+)\\.([a-zA-Z]{2,})(?=\\s|$)/"
            ],
            "exclusions": [
                "/^(.)\\1*$/",
                "@",
                " ",
                "_",
                "www.*",
                "ww2.*"
            ]
        }
    ],
    "transformations": [
        "Deduplicate",
        "InsertFinalNewLine"
    ]
}